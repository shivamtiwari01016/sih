# Samanvay Backend Environment Configuration
# ============================================

# Application
APP_NAME=Samanvay (समन्वय) – Secure Complaint Coordination System for AICTE
APP_ENV=production
DEBUG=false
SECRET_KEY=generate-a-strong-random-secret-key-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings
# Comma-separated list of allowed frontend origins (e.g. Vercel production domain, localhost)
ALLOWED_ORIGINS=https://samanvay.vercel.app,http://localhost:3000,http://localhost:5173
# Regex to match all Vercel preview and production deployment domains
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Database
# Default: SQLite file in backend directory
# On Render Postgres, provide your PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./civicresolve.db

# Auto-seeding
# Automatically populates 4 Bureaus, 40 Users, 300 Institutions, 650 Complaints if database is empty
AUTO_SEED=true
DEMO_MODE=true
SHOW_DEMO_BADGE=true

# ML Matching Settings
USE_SEMANTIC_MATCHING=true
EMBEDDING_MODEL=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.45

# Upload Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760
