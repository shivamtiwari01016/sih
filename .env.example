# Samanvay (समन्वय) – Environment Variables Example
# Copy this file to .env and customize as needed

# Application
APP_NAME=Samanvay (समन्वय) – Secure Complaint Coordination System for AICTE
APP_ENV=development
DEBUG=true
API_V1_STR=/api
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Database
# For SQLite (default):
DATABASE_URL=sqlite:///./backend/civicresolve.db
# For PostgreSQL (e.g. Render, Supabase, Neon):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

AUTO_SEED=true
DEMO_MODE=true
SHOW_DEMO_BADGE=true

# AI/ML Configuration
USE_SEMANTIC_MATCHING=true
EMBEDDING_MODEL=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.45

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,doc,docx,jpg,jpeg,png,txt
