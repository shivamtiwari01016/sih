# Samanvay (समन्वय) – Environment Variables Template
# Copy this file to .env and customize as needed
# NEVER commit .env to version control

# Application
APP_NAME=Samanvay (समन्वय) – Secure Complaint Coordination System for AICTE
APP_ENV=development
DEBUG=True
API_V1_STR=/api
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Database
DATABASE_URL=postgresql://civicresolve:civicresolve_pass@localhost:5432/civicresolve_db
POSTGRES_USER=civicresolve
POSTGRES_PASSWORD=civicresolve_pass
POSTGRES_DB=civicresolve_db

# Redis (for background jobs and caching)
REDIS_URL=redis://localhost:6379/0

# AI/ML Configuration
USE_SEMANTIC_MATCHING=True
EMBEDDING_MODEL=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.45
MAX_CANDIDATES=60
MAX_SUGGESTIONS_PER_COMPLAINT=6
MAX_SCAN_COMPLAINTS=500
MAX_SCAN_SUGGESTIONS=120
TEXT_WEIGHT=0.45
CATEGORY_WEIGHT=0.30
SUBCATEGORY_WEIGHT=0.05
INSTITUTION_WEIGHT=0.20
CROSS_BUREAU_WEIGHT=0.05
DOMAIN_TOPIC_SCORE=0.50
ENABLE_LLM_SUMMARIZATION=False
OPENAI_API_KEY=

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=pdf,doc,docx,jpg,jpeg,png,txt

# SLA/Deadline Configuration (demo defaults)
DEADLINE_WARNING_DAYS=3
OVERDUE_ESCALATION_DAYS=7

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@civicresolve.demo

# Demo Mode
DEMO_MODE=True
SHOW_DEMO_BADGE=True
